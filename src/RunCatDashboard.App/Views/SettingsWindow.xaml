<Window x:Class="RunCatDashboard.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RunCatDashboard 設定" Width="500" Height="820"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        Deactivated="OnWindowDeactivated"
        ShowInTaskbar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <GroupBox Header="Dashboard" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox Content="啟動／一般狀態下顯示 Dashboard"
                              IsChecked="{Binding IsDashboardVisible}" Margin="0,0,0,10" />
                    <TextBlock Text="互動模式" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding InteractionModes}"
                              SelectedItem="{Binding InteractionMode}" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Overlay 模式快捷鍵" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox Content="Ctrl"
                                  IsChecked="{Binding HotKeyControl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,16,0" />
                        <CheckBox Content="Alt"
                                  IsChecked="{Binding HotKeyAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,16,0" />
                        <CheckBox Content="Shift"
                                  IsChecked="{Binding HotKeyShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,16,0" />
                        <CheckBox Content="Windows"
                                  IsChecked="{Binding HotKeyWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <TextBlock Text="主要按鍵" Margin="0,0,0,4" />
                    <TextBox x:Name="HotKeyCaptureField"
                             Text="{Binding HotKeyKeyDisplayText, Mode=OneWay}"
                             IsReadOnly="True" Focusable="True"
                             PreviewMouseLeftButtonDown="OnHotKeyCapturePreviewMouseLeftButtonDown"
                             GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                             PreviewKeyDown="OnHotKeyCapturePreviewKeyDown"
                             ToolTip="點選後按下 A-Z、0-9 或 F1-F12；Esc 取消。"
                             Padding="6,4">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="Gray" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHotKeyCaptureActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="DodgerBlue" />
                                        <Setter Property="BorderThickness" Value="3" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="請按下 A-Z、0-9 或 F1-F12；Esc 取消"
                               Visibility="{Binding IsHotKeyCaptureActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="DodgerBlue" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="點選欄位以擷取主要按鍵。"
                               Foreground="DimGray" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHotKeyCaptureActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding HotKeyCaptureMessage}"
                               Foreground="DarkRed" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Margin="0,8,0,0">
                        <Run Text="目前組合：" />
                        <Run Text="{Binding InteractionHotKeyDisplayText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding HotKeyWarning}"
                               Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding InteractionHotKeyError}"
                               Foreground="DarkRed" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="至少選擇一個 modifier；系統保留快捷鍵不可使用。"
                               Foreground="DimGray" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Dashboard 顯示／隱藏快捷鍵" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="在 Dashboard 顯示或隱藏時切換可見狀態；這組快捷鍵不會切換 Overlay 互動模式。"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox Content="Ctrl"
                                  IsChecked="{Binding VisibilityHotKeyControl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,16,0" />
                        <CheckBox Content="Alt"
                                  IsChecked="{Binding VisibilityHotKeyAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,16,0" />
                        <CheckBox Content="Shift"
                                  IsChecked="{Binding VisibilityHotKeyShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,16,0" />
                        <CheckBox Content="Windows"
                                  IsChecked="{Binding VisibilityHotKeyWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <TextBlock Text="主要按鍵" Margin="0,0,0,4" />
                    <TextBox x:Name="VisibilityHotKeyCaptureField"
                             Text="{Binding VisibilityHotKeyKeyDisplayText, Mode=OneWay}"
                             IsReadOnly="True" Focusable="True"
                             PreviewMouseLeftButtonDown="OnHotKeyCapturePreviewMouseLeftButtonDown"
                             GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                             PreviewKeyDown="OnHotKeyCapturePreviewKeyDown"
                             ToolTip="點選後按下 A-Z、0-9 或 F1-F12；Esc 取消。"
                             Padding="6,4">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="Gray" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisibilityHotKeyCaptureActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="DodgerBlue" />
                                        <Setter Property="BorderThickness" Value="3" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="請按下 A-Z、0-9 或 F1-F12；Esc 取消"
                               Visibility="{Binding IsVisibilityHotKeyCaptureActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="DodgerBlue" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding VisibilityHotKeyCaptureMessage}"
                               Foreground="DarkRed" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Margin="0,8,0,0">
                        <Run Text="目前組合：" />
                        <Run Text="{Binding VisibilityHotKeyDisplayText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding VisibilityHotKeyWarning}"
                               Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding VisibilityHotKeyError}"
                               Foreground="DarkRed" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="至少選擇一個 modifier；系統保留快捷鍵不可使用。"
                               Foreground="DimGray" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="效能" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Metrics sampling interval（毫秒）" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding SamplingIntervals}"
                              SelectedItem="{Binding SamplingIntervalMilliseconds}" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Windows 啟動" Padding="12">
                <StackPanel>
                    <CheckBox Content="登入 Windows 時啟動 RunCatDashboard"
                              IsChecked="{Binding RunAtLoginRequested}" />
                    <TextBlock Margin="0,8,0,0">
                        <Run Text="Applied：" /><Run Text="{Binding RunAtLoginApplied}" />
                    </TextBlock>
                    <TextBlock Text="{Binding StartupFault}" Foreground="DarkRed"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="ValidationErrorTextBlock" Grid.Row="1"
                   Text="{Binding ValidationError}" Foreground="DarkRed"
                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,8" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Command="{Binding CancelCommand}" MinWidth="80" Margin="0,0,8,0" />
            <Button Content="儲存" Command="{Binding SaveCommand}" MinWidth="80" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
